---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dateValue, formatDate, getPublishedWriting } from '../../lib/content';

const entries = await getPublishedWriting();
---

<BaseLayout title="Writing" description="KTY578 的随笔与长文。">
  <main id="main-content" class="shell listing-page">
    <header class="listing-header">
      <p class="eyebrow">01 / Essays</p>
      <h1 lang="en">Writing</h1>
      <p>经过整理的随笔与长文。</p>
    </header>
    {entries.length > 0 ? (
      <ol class="listing-list">
        {entries.map((entry) => (
          <li>
            <article>
              <div><h2><a href={`/writing/${entry.id}/`}>{entry.data.title}</a></h2><p>{entry.data.description}</p></div>
              <time datetime={dateValue(entry.data.date)}>{formatDate(entry.data.date, entry.data.lang)}</time>
            </article>
          </li>
        ))}
      </ol>
    ) : <p class="empty-state empty-state--large">文章即将从这里开始。</p>}
  </main>
</BaseLayout>
