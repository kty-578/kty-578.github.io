---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalizedText from '../../components/LocalizedText.astro';
import { dateValue, formatDate, getPublishedWriting } from '../../lib/content';

const entries = await getPublishedWriting();
---

<BaseLayout title="文章" titleEn="Writing" description="KTY578 的文章与长文。" descriptionEn="Articles and essays by KTY578.">
  <main id="main-content" class="shell listing-page">
    <header class="page-intro">
      <p class="eyebrow"><LocalizedText zh="01 / 文章" en="01 / Essays" /></p>
      <h1><LocalizedText zh="文章" en="Writing" /></h1>
      <p class="page-intro__description"><LocalizedText zh="经过整理的文章与长文。" en="Essays and longer pieces, gathered here." /></p>
    </header>
    {entries.length > 0 ? (
      <ol class="listing-list">
        {entries.map((entry) => (
          <li>
            <article>
              <div lang={entry.data.lang}><h2><a href={`/writing/${entry.id}/`}>{entry.data.title}</a></h2><p>{entry.data.description}</p></div>
              <time datetime={dateValue(entry.data.date)}><LocalizedText zh={formatDate(entry.data.date, 'zh-CN')} en={formatDate(entry.data.date, 'en')} /></time>
            </article>
          </li>
        ))}
      </ol>
    ) : <p class="empty-state empty-state--large"><LocalizedText zh="文章即将从这里开始。" en="Articles will appear here soon." /></p>}
  </main>
</BaseLayout>
