---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalizedText from '../components/LocalizedText.astro';
---

<BaseLayout title="关于" titleEn="About" description="关于 KTY578 与这处个人空间。" descriptionEn="About KTY578 and this personal website.">
  <main id="main-content" class="shell article-shell about-page">
    <article class="article about-article">
      <header class="page-intro">
        <p class="eyebrow"><LocalizedText zh="04 / 关于本站" en="04 / About this place" /></p>
        <h1><LocalizedText zh="关于" en="About" /></h1>
        <p class="page-intro__description"><LocalizedText zh="这里是 KTY578 的个人网站，用来保存写作、阅读、研究与制作过程中的内容。" en="This is KTY578's personal website, a place for writing, reading, research, and making." /></p>
      </header>
      <div class="prose">
        <p class="lang-zh" lang="zh-CN"><a href="/writing/">文章</a>收录长文，<a href="/notes/">随笔</a>收录阅读、研究与日常记录，<a href="/projects/">项目</a>介绍个人项目。每篇内容都有自己的地址，方便日后重新找到。</p>
        <p class="lang-en" lang="en"><a href="/writing/">Writing</a> gathers essays and longer pieces, <a href="/notes/">Notes</a> holds reading and research notes, and <a href="/projects/">Projects</a> introduces personal work. Each page keeps its own address for later reading.</p>
        <p class="lang-zh" lang="zh-CN">网站采用安静、直接的呈现方式，让文章与材料成为阅读的中心。</p>
        <p class="lang-en" lang="en">The site keeps its presentation quiet and direct, with the writing and source material at the center.</p>
        <p class="lang-zh" lang="zh-CN">如果习惯使用阅读器，也可以订阅 <a href="/rss.xml" lang="en">RSS</a>。</p>
        <p class="lang-en" lang="en">If you use a feed reader, you can also subscribe to the <a href="/rss.xml">RSS feed</a>.</p>
      </div>
    </article>
  </main>
</BaseLayout>
