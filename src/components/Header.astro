---
import LocalizedText from './LocalizedText.astro';

const pathname = Astro.url.pathname;
const links = [
  { href: '/writing/', zh: '文章', en: 'Writing' },
  { href: '/notes/', zh: '随笔', en: 'Notes' },
  { href: '/projects/', zh: '项目', en: 'Projects' },
  { href: '/about/', zh: '关于', en: 'About' },
];
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href="/" aria-label="KTY578 首页 / Home">KTY578</a>
    <nav class="main-nav" aria-label="导航 / Navigation">
      {links.map(({ href, zh, en }) => (
        <a href={href} class:list={{ 'is-current': pathname.startsWith(href) }} aria-current={pathname === href ? 'page' : pathname.startsWith(href) ? 'location' : undefined}><LocalizedText {zh} {en} /></a>
      ))}
      <div class="language-switch" role="group" aria-label="语言 / Language">
        <button type="button" data-site-language="zh" aria-pressed="true" lang="zh-CN">ZH</button>
        <span aria-hidden="true">/</span>
        <button type="button" data-site-language="en" aria-pressed="false" lang="en">EN</button>
      </div>
    </nav>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false"><LocalizedText zh="深色模式" en="Dark mode" /></button>
  </div>
</header>
